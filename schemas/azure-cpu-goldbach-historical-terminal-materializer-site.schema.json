{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.invalid/schemas/azure-cpu-goldbach-historical-terminal-materializer-site.schema.json",
  "title": "SparkInterval historical Helfgott--Platt Goldbach terminal materializer site",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_site", "historical_goldbach", "kind", "schema_version"],
  "properties": {
    "base_site": {"$ref": "#/$defs/filePin"},
    "historical_goldbach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_admission", "child_identity_commitment", "terminal_handoff"],
      "properties": {
        "build_admission": {"$ref": "#/$defs/filePin"},
        "child_identity_commitment": {"$ref": "#/$defs/filePin"},
        "terminal_handoff": {"$ref": "#/$defs/filePin"}
      }
    },
    "kind": {"const": "sparkinterval.azure.cpu.helfgott-platt-goldbach-terminal-materializer-site.v1"},
    "schema_version": {"const": 1}
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$)).+$"},
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
      }
    }
  }
}
