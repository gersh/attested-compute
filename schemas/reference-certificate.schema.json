{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.invalid/schemas/reference-certificate.schema.json",
  "title": "SparkInterval self-contained exact-reference certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "batch", "batch_sha256", "result", "result_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "sparkinterval_reference_certificate"},
    "batch": {"$ref": "#/$defs/batch"},
    "batch_sha256": {"$ref": "#/$defs/sha256"},
    "result": {"$ref": "#/$defs/result"},
    "result_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finiteBinary64": {
      "type": "string",
      "pattern": "^(?!7ff|fff)[0-9a-f]{16}$"
    },
    "endpointBinary64": {
      "oneOf": [
        {"$ref": "#/$defs/finiteBinary64"},
        {"enum": ["7ff0000000000000", "fff0000000000000"]}
      ]
    },
    "finiteInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lo", "hi"],
      "properties": {
        "lo": {"$ref": "#/$defs/finiteBinary64"},
        "hi": {"$ref": "#/$defs/finiteBinary64"}
      }
    },
    "endpointInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lo", "hi"],
      "properties": {
        "lo": {"$ref": "#/$defs/endpointBinary64"},
        "hi": {"$ref": "#/$defs/endpointBinary64"}
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "value"],
          "properties": {
            "op": {"const": "const"},
            "value": {"$ref": "#/$defs/finiteInterval"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "index"],
          "properties": {
            "op": {"const": "var"},
            "index": {"type": "integer", "minimum": 0, "maximum": 65535}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "arg"],
          "properties": {
            "op": {"enum": ["neg", "abs"]},
            "arg": {"$ref": "#/$defs/expression"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "arg", "exponent"],
          "properties": {
            "op": {"const": "pow_nat"},
            "arg": {"$ref": "#/$defs/expression"},
            "exponent": {"type": "integer", "minimum": 0, "maximum": 64}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "left", "right"],
          "properties": {
            "op": {"enum": ["add", "sub", "mul", "div", "min", "max"]},
            "left": {"$ref": "#/$defs/expression"},
            "right": {"$ref": "#/$defs/expression"}
          }
        }
      ]
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "algorithm", "variable_count", "expression", "rows"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "sparkinterval_reference_batch"},
        "algorithm": {"const": "sparkinterval.binary64_interval_expr.v1"},
        "variable_count": {"type": "integer", "minimum": 0, "maximum": 65536},
        "expression": {"$ref": "#/$defs/expression"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000000,
          "items": {
            "type": "array",
            "maxItems": 65536,
            "items": {"$ref": "#/$defs/finiteInterval"}
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "algorithm", "batch_sha256", "rows"],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "sparkinterval_reference_result"},
        "algorithm": {"const": "sparkinterval.binary64_interval_expr.v1"},
        "batch_sha256": {"$ref": "#/$defs/sha256"},
        "rows": {
          "type": "array",
          "maxItems": 1000000,
          "items": {"$ref": "#/$defs/endpointInterval"}
        }
      }
    }
  }
}
