{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.example/schemas/azure-h100-goldbach-historical-materialization.schema.json",
  "title": "Source-height historical Goldbach Azure H100 materialization manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted",
    "build_admission",
    "build_identity_sha256",
    "build_steps",
    "challenge_pin",
    "classification",
    "execution_completed",
    "execution_projection_sha256",
    "factory_id",
    "h100_operator_config",
    "job_spec",
    "kind",
    "lean_theorem_produced",
    "package",
    "plan_predecessor",
    "portfolio_shard_config",
    "registered_invocation",
    "retained_export_inside_certificate",
    "runtime_image_closure_sha256",
    "schema_version",
    "shard_index",
    "source_manifest_sha256",
    "source_run_receipt_produced",
    "transcript_policy"
  ],
  "properties": {
    "accepted": { "const": false },
    "build_admission": { "$ref": "#/$defs/filePin" },
    "build_identity_sha256": { "$ref": "#/$defs/sha256" },
    "build_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "challenge_pin": { "$ref": "#/$defs/filePin" },
    "classification": {
      "const": "source_reviewed_historical-goldbach_h100_operator_validated_materialization_not_execution_evidence"
    },
    "execution_completed": { "const": false },
    "execution_projection_sha256": { "$ref": "#/$defs/sha256" },
    "factory_id": {
      "type": "string",
      "pattern": "^historical_goldbach_h100_group_[0-9]{8}_v1$"
    },
    "h100_operator_config": { "$ref": "#/$defs/filePin" },
    "job_spec": { "$ref": "#/$defs/filePin" },
    "kind": {
      "const": "sparkinterval.azure.h100.helfgott-platt-goldbach-materialization.v1"
    },
    "lean_theorem_produced": { "const": false },
    "package": { "$ref": "#/$defs/filePin" },
    "plan_predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_sha256", "tree_sha256"],
      "properties": {
        "receipt_sha256": { "$ref": "#/$defs/sha256" },
        "tree_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "portfolio_shard_config": { "$ref": "#/$defs/filePin" },
    "registered_invocation": { "type": "null" },
    "retained_export_inside_certificate": {
      "type": "string",
      "pattern": "^bundle-root/work/goldbach-historical-h100-[0-9]{8}/goldbach-historical-h100-group-[0-9]{8}\\.tar$"
    },
    "runtime_image_closure_sha256": { "$ref": "#/$defs/sha256" },
    "schema_version": { "const": 1 },
    "shard_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8191
    },
    "source_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "source_run_receipt_produced": { "const": false },
    "transcript_policy": { "$ref": "#/$defs/filePin" }
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$)).+$"
    },
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    }
  }
}
