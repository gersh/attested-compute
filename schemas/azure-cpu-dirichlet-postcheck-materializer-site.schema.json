{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.invalid/schemas/azure-cpu-dirichlet-postcheck-materializer-site.schema.json",
  "title": "SparkInterval Dirichlet retained postcheck Azure CPU materializer site",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_site", "dirichlet_postcheck", "kind", "schema_version"],
  "properties": {
    "base_site": {"$ref": "#/$defs/filePin"},
    "dirichlet_postcheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flint_source_root",
        "predecessor_certificate_archive",
        "predecessor_trusted_receipt",
        "python_flint_source_root",
        "python_flint_wheel"
      ],
      "properties": {
        "flint_source_root": {"$ref": "#/$defs/absolutePath"},
        "predecessor_certificate_archive": {"$ref": "#/$defs/filePin"},
        "predecessor_trusted_receipt": {"$ref": "#/$defs/filePin"},
        "python_flint_source_root": {"$ref": "#/$defs/absolutePath"},
        "python_flint_wheel": {"$ref": "#/$defs/filePin"}
      }
    },
    "kind": {"const": "sparkinterval.azure.cpu.dirichlet-postcheck-materializer-site.v1"},
    "schema_version": {"const": 1}
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$)).+$"},
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
