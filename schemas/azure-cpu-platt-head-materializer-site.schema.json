{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.invalid/schemas/azure-cpu-platt-head-materializer-site.schema.json",
  "title": "SparkInterval Platt-head Azure CPU materializer site",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_site", "kind", "platt_head", "schema_version"],
  "properties": {
    "base_site": {"$ref": "#/$defs/filePin"},
    "kind": {"const": "sparkinterval.azure.cpu.platt-head-materializer-site.v1"},
    "platt_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flint_source_root", "python_flint_source_root", "python_flint_wheel"],
      "properties": {
        "flint_source_root": {"$ref": "#/$defs/absolutePath"},
        "python_flint_source_root": {"$ref": "#/$defs/absolutePath"},
        "python_flint_wheel": {"$ref": "#/$defs/filePin"}
      }
    },
    "schema_version": {"const": 1}
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$)).+$"},
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
