{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.invalid/schemas/azure-cpu-prop1224-materialization.schema.json",
  "title": "SparkInterval Proposition 12.2.4 Azure CPU materialization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "accepted", "build_steps", "challenge_pin", "classification",
    "cpu_operator_config", "execution_completed", "factory_id", "handoff",
    "job_spec", "kind", "lean_theorem_produced", "package", "phase_id",
    "portfolio_shard_config", "predecessor_receipts", "registered_invocation",
    "runtime", "schema_version", "semantic_terminal", "shard_index",
    "source_run_receipt_produced", "transcript_policy"
  ],
  "properties": {
    "accepted": {"const": false},
    "build_steps": {"type": "array"},
    "challenge_pin": {"$ref": "#/$defs/filePin"},
    "classification": {"const": "source_reviewed_prop1224_operator_validated_materialization_not_execution_evidence"},
    "cpu_operator_config": {"$ref": "#/$defs/filePin"},
    "execution_completed": {"const": false},
    "factory_id": {"type": "string", "minLength": 1},
    "handoff": {"type": "object"},
    "job_spec": {"$ref": "#/$defs/filePin"},
    "kind": {"const": "sparkinterval.azure.cpu.prop1224-materialization.v1"},
    "lean_theorem_produced": {"const": false},
    "package": {"$ref": "#/$defs/filePin"},
    "phase_id": {"enum": ["mpfr-shards", "merge-and-verify"]},
    "portfolio_shard_config": {"$ref": "#/$defs/filePin"},
    "predecessor_receipts": {"type": "array", "maxItems": 4},
    "registered_invocation": {"type": ["string", "null"]},
    "runtime": {"type": "object"},
    "schema_version": {"const": 1},
    "semantic_terminal": {"type": "boolean"},
    "shard_index": {"type": "integer", "minimum": 0, "maximum": 3},
    "source_run_receipt_produced": {"const": false},
    "transcript_policy": {"$ref": "#/$defs/filePin"}
  },
  "$defs": {
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    }
  }
}
