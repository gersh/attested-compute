{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.invalid/schemas/azure-cpu-prop1224-materializer-site.schema.json",
  "title": "SparkInterval Proposition 12.2.4 Azure CPU materializer site",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_site", "kind", "prop1224", "schema_version"],
  "properties": {
    "base_site": {"$ref": "#/$defs/filePin"},
    "kind": {"const": "sparkinterval.azure.cpu.prop1224-materializer-site.v1"},
    "prop1224": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gmp_source_root", "mpfr_source_root", "predecessor_exports"],
      "properties": {
        "gmp_source_root": {"$ref": "#/$defs/absolutePath"},
        "mpfr_source_root": {"$ref": "#/$defs/absolutePath"},
        "predecessor_exports": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["export", "group_id", "shard_index"],
            "properties": {
              "export": {"$ref": "#/$defs/filePin"},
              "group_id": {"type": "string", "minLength": 1, "maxLength": 256},
              "shard_index": {"type": "integer", "minimum": 0, "maximum": 3}
            }
          }
        }
      }
    },
    "schema_version": {"const": 1}
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$)).+$"},
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
