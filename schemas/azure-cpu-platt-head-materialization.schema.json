{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.invalid/schemas/azure-cpu-platt-head-materialization.schema.json",
  "title": "SparkInterval Platt-head Azure CPU materialization manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["accepted", "build_steps", "challenge_pin", "classification", "cpu_operator_config", "execution_completed", "factory_id", "job_spec", "kind", "lean_theorem_produced", "package", "portfolio_shard_config", "registered_invocation", "runtime", "schema_version", "semantic_binding_enabled", "source_run_receipt_produced", "transcript_policy"],
  "properties": {
    "accepted": {"const": false},
    "build_steps": {"type": "array", "minItems": 2, "maxItems": 2},
    "challenge_pin": {"$ref": "#/$defs/filePin"},
    "classification": {"const": "source_reviewed_platt_head_operator_validated_materialization_not_execution_evidence"},
    "cpu_operator_config": {"$ref": "#/$defs/filePin"},
    "execution_completed": {"const": false},
    "factory_id": {"const": "platt_head_2e4_python_flint_x86_cpu_v1"},
    "job_spec": {"$ref": "#/$defs/filePin"},
    "kind": {"const": "sparkinterval.azure.cpu.platt-head-materialization.v1"},
    "lean_theorem_produced": {"const": false},
    "package": {"$ref": "#/$defs/filePin"},
    "portfolio_shard_config": {"$ref": "#/$defs/filePin"},
    "registered_invocation": {"const": "plattHead2e4ProductionV1"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extracted_wheel_tree_sha256", "path", "python_version", "sha256", "shared_object_count", "size_bytes", "wheel_sha256"],
      "properties": {
        "extracted_wheel_tree_sha256": {"$ref": "#/$defs/sha256"},
        "path": {"$ref": "#/$defs/absolutePath"},
        "python_version": {"type": "string", "pattern": "^Python 3\\.(1[0-9]|[2-9][0-9])(?:\\.|$)"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "shared_object_count": {"type": "integer", "minimum": 1, "maximum": 2000},
        "size_bytes": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "wheel_sha256": {"const": "376b88cacd30612479e839ffdba887599d3f9c8c0e214852bf80bb2b194e4d76"}
      }
    },
    "schema_version": {"const": 1},
    "semantic_binding_enabled": {"type": "boolean"},
    "source_run_receipt_produced": {"const": false},
    "transcript_policy": {"$ref": "#/$defs/filePin"}
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$)).+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    }
  }
}
