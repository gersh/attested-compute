{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.invalid/schemas/azure-cpu-cdem-artifact-terminal-materializer-site.schema.json",
  "title": "SparkInterval Azure CPU CDEM artifact-terminal materializer site",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_site", "cdem", "kind", "schema_version"],
  "properties": {
    "base_site": {"$ref": "#/$defs/filePin"},
    "cdem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge_ttl_seconds", "producer_certificate_archive"],
      "properties": {
        "challenge_ttl_seconds": {
          "type": "integer",
          "minimum": 140401,
          "maximum": 604800
        },
        "producer_certificate_archive": {"$ref": "#/$defs/filePin"}
      }
    },
    "kind": {
      "const": "sparkinterval.azure.cpu.cdem-artifact-terminal-materializer-site.v1"
    },
    "schema_version": {"const": 1}
  },
  "$defs": {
    "absolutePath": {
      "type": "string",
      "pattern": "^/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$)).+$"
    },
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}
