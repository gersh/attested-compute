{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.invalid/schemas/azure-cpu-psi-portfolio-materialization.schema.json",
  "title": "SparkInterval CH25 psi Azure CPU materialization manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["accepted", "build_steps", "challenge_pin", "classification", "compiler", "cpu_operator_config", "execution_completed", "factory_id", "handoff", "job_spec", "kind", "lean_theorem_produced", "package", "phase_id", "portfolio_shard_config", "predecessor_receipts", "registered_invocation", "schema_version", "semantic_terminal", "shard_index", "source_run_receipt_produced", "transcript_policy"],
  "properties": {
    "accepted": {"const": false},
    "build_steps": {"type": "array", "minItems": 1},
    "challenge_pin": {"$ref": "#/$defs/filePin"},
    "classification": {"const": "source_reviewed_psi_operator_validated_materialization_not_execution_evidence"},
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "version_line"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "version_line": {"type": "string", "minLength": 1}
      }
    },
    "cpu_operator_config": {"$ref": "#/$defs/filePin"},
    "execution_completed": {"const": false},
    "factory_id": {"type": "string", "pattern": "^ch25_psi_[a-z0-9-]+_[0-9]{3}_image_cpu_v1$"},
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "group_index", "kind", "phase", "schema_version"],
      "properties": {
        "entries": {"type": "array", "maxItems": 321},
        "group_index": {"type": "integer", "minimum": 0, "maximum": 319},
        "kind": {"const": "sparkinterval.azure.psi-phase-handoff.v1"},
        "phase": {"enum": ["initialize", "summary-shards", "reduce-summaries", "verify-shards", "finalize", "semantic-replay"]},
        "schema_version": {"const": 1}
      }
    },
    "job_spec": {"$ref": "#/$defs/filePin"},
    "kind": {"const": "sparkinterval.azure.cpu.psi-portfolio-materialization.v1"},
    "lean_theorem_produced": {"const": false},
    "package": {"$ref": "#/$defs/filePin"},
    "phase_id": {"enum": ["initialize", "summary-shards", "reduce-summaries", "verify-shards", "finalize", "semantic-replay"]},
    "portfolio_shard_config": {"$ref": "#/$defs/filePin"},
    "predecessor_receipts": {
      "type": "array",
      "maxItems": 321,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "receipt_sha256", "shard_index"],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "receipt_sha256": {"$ref": "#/$defs/sha256"},
          "shard_index": {"type": "integer", "minimum": 0, "maximum": 319}
        }
      }
    },
    "registered_invocation": {"enum": [null, "ch25PsiLemma92ProductionV1"]},
    "schema_version": {"const": 1},
    "semantic_terminal": {"type": "boolean"},
    "shard_index": {"type": "integer", "minimum": 0, "maximum": 319},
    "source_run_receipt_produced": {"const": false},
    "transcript_policy": {"$ref": "#/$defs/filePin"}
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$)).+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    }
  }
}
