{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gersh.github.io/gpu_prover/schemas/platt-pt21-lean-block-artifact.schema.json",
  "title": "Compact exact PT21 block-to-Lean handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "upstream_commit",
    "block",
    "height_lower",
    "height_upper",
    "window_center",
    "required_sign_packet_sha256",
    "source_trace_sha256",
    "streams",
    "turing"
  ],
  "properties": {
    "schema": {"const": "sparkinterval.tg.platt-pt21-lean-block-artifact.v2"},
    "upstream_commit": {"const": "42b21426718e542daa2b006dc05ea2d7f26426e6"},
    "block": {"type": "integer", "minimum": 0, "maximum": 2966443782},
    "height_lower": {"type": "integer", "minimum": 10000000000},
    "height_upper": {"type": "integer", "minimum": 10000001008},
    "window_center": {"type": "integer", "minimum": 10000000504},
    "required_sign_packet_sha256": {"$ref": "#/$defs/sha256"},
    "source_trace_sha256": {"$ref": "#/$defs/sha256"},
    "streams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main", "left_flank", "right_flank"],
      "properties": {
        "main": {"$ref": "#/$defs/stream"},
        "left_flank": {"$ref": "#/$defs/stream"},
        "right_flank": {"$ref": "#/$defs/stream"}
      }
    },
    "turing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": {"$ref": "#/$defs/turingSide"},
        "upper": {"$ref": "#/$defs/turingSide"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lo", "hi"],
      "properties": {
        "lo": {"$ref": "#/$defs/rational"},
        "hi": {"$ref": "#/$defs/rational"}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enclosure", "positive"],
      "properties": {
        "enclosure": {"$ref": "#/$defs/interval"},
        "positive": {"type": "boolean"}
      }
    },
    "bracket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower_offset",
        "upper_offset",
        "lower_value",
        "upper_value",
        "resolver",
        "fallback_receipt_sha256"
      ],
      "properties": {
        "lower_offset": {"$ref": "#/$defs/rational"},
        "upper_offset": {"$ref": "#/$defs/rational"},
        "lower_value": {"$ref": "#/$defs/endpoint"},
        "upper_value": {"$ref": "#/$defs/endpoint"},
        "resolver": {
          "enum": [
            "direct",
            "stationary_left",
            "stationary_right",
            "pinned_arb_fallback"
          ]
        },
        "fallback_receipt_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_boundary", "right_boundary", "brackets", "events"],
      "properties": {
        "left_boundary": {"$ref": "#/$defs/endpoint"},
        "right_boundary": {"$ref": "#/$defs/endpoint"},
        "brackets": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/bracket"}
        },
        "events": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/event"}
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_sample", "right_sample", "multiplicity"],
      "properties": {
        "left_sample": {"type": "integer", "minimum": -12800, "maximum": 12799},
        "right_sample": {"type": "integer", "minimum": -12799, "maximum": 12800},
        "multiplicity": {"enum": [1, 2]}
      }
    },
    "turingSide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["s_bound", "log_pi", "im_gamma_integral", "pi", "quotient", "count"],
      "properties": {
        "s_bound": {"$ref": "#/$defs/interval"},
        "log_pi": {"$ref": "#/$defs/interval"},
        "im_gamma_integral": {"$ref": "#/$defs/interval"},
        "pi": {"$ref": "#/$defs/interval"},
        "quotient": {"$ref": "#/$defs/interval"},
        "count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
