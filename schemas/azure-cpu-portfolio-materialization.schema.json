{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.invalid/schemas/azure-cpu-portfolio-materialization.schema.json",
  "title": "SparkInterval Azure CPU portfolio materialization manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["accepted", "build_steps", "challenge_pin", "classification", "compiler", "cpu_operator_config", "execution_completed", "factory_id", "job_spec", "kind", "lean_theorem_produced", "package", "portfolio_shard_config", "registered_invocation", "schema_version", "source_run_receipt_produced", "transcript_policy"],
  "properties": {
    "accepted": {"const": false},
    "build_steps": {"type": "array", "minItems": 1},
    "challenge_pin": {"$ref": "#/$defs/filePin"},
    "classification": {"const": "source_reviewed_operator_validated_materialization_not_execution_evidence"},
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "version_line"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "version_line": {"type": "string", "minLength": 1}
      }
    },
    "cpu_operator_config": {"$ref": "#/$defs/filePin"},
    "execution_completed": {"const": false},
    "factory_id": {"const": "cdem_table_abel_static_cpu_v2"},
    "job_spec": {"$ref": "#/$defs/filePin"},
    "kind": {"const": "sparkinterval.azure.cpu.portfolio-materialization.v1"},
    "lean_theorem_produced": {"const": false},
    "package": {"$ref": "#/$defs/filePin"},
    "portfolio_shard_config": {"$ref": "#/$defs/filePin"},
    "registered_invocation": {"const": "cdemTableAbelProductionV2"},
    "schema_version": {"const": 1},
    "source_run_receipt_produced": {"const": false},
    "transcript_policy": {"$ref": "#/$defs/filePin"}
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$)).+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    }
  }
}
