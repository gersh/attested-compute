{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.invalid/schemas/sqrt218-finite-certificate.schema.json",
  "title": "Sqrt218 complete finite certificate archive",
  "type": "object",
  "additionalProperties": false,
  "required": ["bound", "events", "kind", "log_scale", "log_seed_at", "primes", "reciprocal_scale", "schema_version", "summary"],
  "properties": {
    "bound": {"type": "integer", "minimum": 2, "maximum": 2000000},
    "kind": {"const": "sparkinterval.sqrt218-finite-certificate.v1"},
    "log_scale": {"const": 281474976710656},
    "log_seed_at": {"const": 30},
    "reciprocal_scale": {"const": 1073741824},
    "schema_version": {"const": 1},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 149235,
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "integer", "minimum": 2, "maximum": 2000000},
          {"type": "integer", "minimum": 0, "maximum": 148932},
          {"type": "integer", "minimum": 1, "maximum": 64}
        ],
        "minItems": 3,
        "maxItems": 3
      }
    },
    "primes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 148933,
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "integer", "minimum": 2, "maximum": 2000000},
          {"type": "integer", "minimum": 0, "maximum": 2000000},
          {"type": "array", "items": {"type": "integer", "minimum": 2, "maximum": 2000000}},
          {"type": "integer", "minimum": 0},
          {"type": "integer", "minimum": 0}
        ],
        "minItems": 5,
        "maxItems": 5
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_slack", "final_psi_lower", "final_weighted_upper", "fixed_scan_sha256", "layout_sha256", "minimum_head_n", "minimum_head_slack", "power_event_count", "pratt_sha256", "prime_count", "proper_power_count", "reused_prime_count", "tail_prime_count"],
      "properties": {
        "anchor_slack": {"type": "integer", "minimum": 1},
        "final_psi_lower": {"type": "integer", "minimum": 1},
        "final_weighted_upper": {"type": "integer", "minimum": 1},
        "fixed_scan_sha256": {"$ref": "#/$defs/sha256"},
        "layout_sha256": {"$ref": "#/$defs/sha256"},
        "minimum_head_n": {"type": "integer", "minimum": 2, "maximum": 2000000},
        "minimum_head_slack": {"type": "integer", "minimum": 1},
        "power_event_count": {"type": "integer", "minimum": 1, "maximum": 149235},
        "pratt_sha256": {"$ref": "#/$defs/sha256"},
        "prime_count": {"type": "integer", "minimum": 1, "maximum": 148933},
        "proper_power_count": {"type": "integer", "minimum": 0, "maximum": 302},
        "reused_prime_count": {"type": "integer", "minimum": 0, "maximum": 115408},
        "tail_prime_count": {"type": "integer", "minimum": 0, "maximum": 33525}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
