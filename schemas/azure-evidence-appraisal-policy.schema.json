{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkinterval.invalid/schemas/azure-evidence-appraisal-policy.schema.json",
  "title": "SparkInterval Azure evidence appraisal policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "allowed_backends",
    "azure_appraiser",
    "nvidia_appraiser"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "sparkinterval_azure_evidence_appraisal_policy"},
    "allowed_backends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["azure_sevsnp_cpu", "azure_ncc40ads_h100_v5"]
      }
    },
    "azure_appraiser": {"$ref": "#/$defs/appraiser"},
    "nvidia_appraiser": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executable_path",
            "executable_sha256",
            "policy_path",
            "policy_sha256",
            "timeout_seconds",
            "verifier",
            "nras_url"
          ],
          "properties": {
            "executable_path": {"type": "string", "minLength": 1},
            "executable_sha256": {"$ref": "#/$defs/sha256"},
            "policy_path": {"type": "string", "minLength": 1},
            "policy_sha256": {"$ref": "#/$defs/sha256"},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "verifier": {"enum": ["local", "remote"]},
            "nras_url": {"type": "string", "pattern": "^https://"}
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "appraiser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable_path",
        "executable_sha256",
        "maa_attestation_url",
        "maa_accepted_issuer",
        "maa_accepted_audience",
        "maa_accepted_provider",
        "policy_path",
        "policy_sha256",
        "timeout_seconds"
      ],
      "properties": {
        "executable_path": {"type": "string", "minLength": 1},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "maa_attestation_url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+/attest/SevSnpVm\\?api-version=2022-08-01$"
        },
        "maa_accepted_issuer": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+$"},
        "maa_accepted_audience": {"type": "string", "minLength": 1},
        "maa_accepted_provider": {"const": "maa_snp"},
        "policy_path": {"type": "string", "minLength": 1},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    }
  }
}
