+    // word bit j represents word_low + 2*j.  P is an odd compile-time
+    // constant, so CUDA lowers both remainders to multiply/shift sequences.
+    constexpr uint32_t inverse_two = (P + 1) / 2;
+    uint32_t residue = static_cast<uint32_t>(word_low % P);
+    uint32_t first = static_cast<uint32_t>(
+        (static_cast<uint64_t>((P - residue) % P) * inverse_two) % P);
+    constexpr uint64_t p_squared = static_cast<uint64_t>(P) * P;
+    for (uint32_t bit = first; bit < 64; bit += P) {
+        uint64_t candidate = word_low + 2 * static_cast<uint64_t>(bit);
+        if (candidate >= p_squared) word &= ~(1ULL << bit);
+    }
