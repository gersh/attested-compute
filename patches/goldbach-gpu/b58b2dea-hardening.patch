+static uint64_t integer_sqrt_u64(uint64_t value) {
+    uint64_t result = 0;
+    uint64_t low = 1;
+    uint64_t high = std::min<uint64_t>(value, 1ULL << 32);
+    while (low <= high) {
+        uint64_t middle = low + (high - low) / 2;
+        if (middle <= value / middle) {
+            result = middle;
+            low = middle + 1;
+        } else {
+            high = middle - 1;
+        }
+    }
+    return result;
+}
 
