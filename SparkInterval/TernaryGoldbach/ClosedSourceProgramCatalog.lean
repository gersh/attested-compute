/-! ## Status data -/

/-- Human-auditable missing pieces for one campaign.

Each required field is written as a declaration-shaped specification, rather
than a vague project note.  `existingPieces` prevents a useful inner checker
from being confused with the still-missing closed finalizer. -/
structure MissingProgramClassification where
  existingPieces : List String
  requiredGenerator : String
  requiredParser : String
  requiredTotalCheck : String
  requiredSoundness : String
  deriving Repr, DecidableEq

/-- A reviewed closed Boolean program.

The equality forces the source program itself to be the generic canonical
input gate around one closed Boolean.  In particular, a future concrete entry
cannot define its run function by invoking the propositional acceptance
relation. -/
structure ConcreteProgram (campaign : Campaign) where
  check : Bool
  certificate : Certificate campaign.checker
  canonicalProgram :
    certificate.program =
      SparkInterval.Execution.Architecture.CanonicalBooleanProgram.program
        campaign.checker campaign.canonicalInput
          campaign.canonicalResult check

/-- A reviewed complete-artifact source program.

The fields expose the data type, parser, and Boolean instead of storing an
arbitrary deterministic-program certificate.  `certificate` below is always
constructed by the generic parsed-certificate program, so its successful
branch cannot call the propositional checker relation.  `legacyAcceptance`
is the ordinary theorem which connects the stronger artifact-input checker
to the existing descriptor-input campaign checker. -/
structure ArtifactConcreteProgram (campaign : Campaign) where
  CertificateData : Type
  artifactChecker : NativeCheckerSemantics
  decode : ByteArray → Option CertificateData
  check : CertificateData → Bool
  successResult : ByteArray
  sound :
    SparkInterval.Execution.Architecture.ParsedCertificateProgram.ParseCheckSound
      artifactChecker decode check successResult
  legacyAcceptance :
    ∀ {inputBytes outputBytes : ByteArray},
      artifactChecker.accepts inputBytes outputBytes →
        campaign.checker.accepts
          campaign.canonicalInput campaign.canonicalResult

namespace ArtifactConcreteProgram

/-- The only source certificate admitted by an artifact-concrete entry. -/
def certificate
    {campaign : Campaign}
    (program : ArtifactConcreteProgram campaign) :
    Certificate program.artifactChecker :=
  SparkInterval.Execution.Architecture.ParsedCertificateProgram.certificate
    program.artifactChecker program.decode program.check
      program.successResult program.sound

/-- Package the exact artifact program for architecture refinement while
keeping the fixed legacy checker projection separate from the measured
artifact input. -/
def projectedCertificate
    {campaign : Campaign}
    (program : ArtifactConcreteProgram campaign) :
    SparkInterval.Execution.Architecture.ProjectedCertificateProgram.Certificate
      program.artifactChecker campaign.checker where
  sourceProgram := program.certificate
  downstreamInput := campaign.canonicalInput
  downstreamResult := campaign.canonicalResult
  project := program.legacyAcceptance

end ArtifactConcreteProgram

/-- Current source-program availability for an exact campaign. -/
inductive ProgramStatus (campaign : Campaign) where
  | concrete (program : ConcreteProgram campaign)
  | artifactConcrete (program : ArtifactConcreteProgram campaign)
  | missing (classification : MissingProgramClassification)

