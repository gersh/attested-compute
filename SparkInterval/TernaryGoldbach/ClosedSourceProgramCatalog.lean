/-! ## Closed audit result -/

/-- The complete CDEM artifact-input source boundary.

This value contains no production artifact and no machine refinement.  It
states only that the exact total parser/Boolean source program is present and
that successful artifact checking implies the legacy campaign acceptance. -/
def cdemAbelConcrete :
    ArtifactConcreteProgram Campaign.cdemTableAbel where
  CertificateData := CDEMAbelArtifactProgram.Recurrence.Certificate
  artifactChecker := CDEMAbelArtifactProgram.artifactNativeChecker
  decode := CDEMAbelArtifactProgram.decode
  check := CDEMAbelClosedReplay.check
  successResult := CDEMAbelCompactChecker.canonicalResultBytes
  sound := CDEMAbelArtifactProgram.parseCheckSound
  legacyAcceptance := by
    intro inputBytes outputBytes accepted
    exact
      CDEMAbelArtifactProgram.legacy_accepts_of_artifact_acceptance
        accepted

/-- Current closed catalog.  CDEM has a complete artifact-input source
program.  Every other campaign remains fail closed with an explicit gap. -/
def status : (campaign : Campaign) → ProgramStatus campaign
  | .ch25A7Boundary => .missing a7Missing
  | .ch25PsiLemma92 => .missing psiMissing
  | .plattHead2e4 => .missing zetaHeadMissing
  | .plattTrudgianRH3e12 => .missing zetaRHMissing
  | .helfgottProp1224 => .missing prop1224Missing
  | .hurstSharedFourResidual => .missing hurstMissing
  | .cdemTableAbel => .artifactConcrete cdemAbelConcrete
  | .ramareZunigaLemma62 => .missing r2StarMissing
  | .helfgottPlattTheorem41 => .missing goldbachMissing
  | .plattDirichletTheorem71 => .missing plattDirichletMissing
  | .ramareProductionFolds => .missing ramareFoldsMissing

/-- Decidable projection used only to summarize this closed catalog. -/
def isConcrete (campaign : Campaign) : Bool :=
  match status campaign with
  | .concrete _ => true
  | .artifactConcrete _ => true
  | .missing _ => false

/-- The audit roster is exactly the registry's ten external campaigns plus
its sole Ramaré native-family fallback. -/
theorem invocationRoster_exact :
    Campaign.all.map Campaign.invocation =
      RegisteredArchitectureInvocation.externalCampaigns ++
        RegisteredArchitectureInvocation.nativeFamilyFallbacks := by
  rfl

/-- The bounded audit covers exactly eleven physical campaigns. -/
theorem auditedCampaignCount : Campaign.all.length = 11 := by
  rfl

/-- CDEM is source-program complete at the full artifact boundary. -/
theorem cdemAbel_status_concrete :
    status Campaign.cdemTableAbel =
      .artifactConcrete cdemAbelConcrete := by
  rfl

/-- Every campaign other than CDEM remains missing. -/
theorem noConcreteCampaign
    (campaign : Campaign)
    (notCDEM : campaign ≠ Campaign.cdemTableAbel) :
    isConcrete campaign = false := by
  cases campaign <;> simp_all [isConcrete, status]

/-- Exact source-program-complete roster. -/
theorem concreteCampaigns :
    Campaign.all.filter isConcrete = [.cdemTableAbel] := by
  rfl

/-- Machine-checkable summary of the current audit result. -/
theorem concreteCampaignCount :
    (Campaign.all.filter isConcrete).length = 1 := by
  rfl

end SparkInterval.TernaryGoldbach.ClosedSourceProgramCatalog
