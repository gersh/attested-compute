  rfl

/-! ## Refusals

A checker that returned `true` unconditionally would satisfy everything above.
These say it does not. -/

/-- One flipped hexadecimal digit in the expected digest and the quote no
longer binds it. -/
theorem segQuote_rejectsAlteredDigest :
    TdxQuoteV4.quoteBindsStatement segQuote
      "53e584409d7572f87f1e00cd8441a35774d697af216021be2cdf8f9fc7233f5e"
        = false := rfl

/-- One flipped hexadecimal digit in the compose hash and the measured
configuration no longer matches. -/
theorem segQuote_rejectsAlteredCompose :
    TdxQuoteV4.quoteBindsCompose segQuote
      "37cee7b985b13b3f88585eec9a6b9e9b01e34729d4c93ce75f79fa4354bff2b9"
        = false := rfl

/-- The digest of a *different* statement is not what the quote attests.  The
statement bytes without the domain separator hash to something else, and the
quote does not bind that. -/
theorem segQuote_rejectsUndomainedDigest :
    TdxQuoteV4.quoteBindsStatement segQuote
      "2db77f3888652e92ca8826a0ec4a4bf278ed923baf9e93ed71193f7946a3f119" = false := rfl

/-- A truncated quote -- here, the first 600 bytes, four short of a TD report
body -- is refused by the structural check rather than parsed into zeros. -/
def segQuoteTruncated : PackedBytes :=
  ⟨segQuote.field 0 600, 600⟩

theorem segQuoteTruncated_rejected :
    TdxQuoteV4.wellFormed segQuoteTruncated = false :=
  TdxQuoteV4.wellFormed_eq_false_of_short (by decide)

/-- The truncated quote no longer carries report data, so it binds no
statement.

Note what it *does* still carry: `mr_config_id` sits at offset 232 and
survives a cut at 600 bytes, so the compose binding alone would accept it.
That is precisely why `wellFormed` guards the length independently of either
binding -- a partial quote must not be allowed to satisfy the checks that
happen to fall inside the surviving prefix. -/
theorem segQuoteTruncated_bindsNoStatement :
    TdxQuoteV4.quoteBindsStatement segQuoteTruncated
      "53e584409d7572f87f1e00cd8441a35774d697af216021be2cdf8f9fc7233f5d"
        = false := by
  rfl

/-- An empty quote is refused. -/
theorem segQuoteEmpty_rejected : TdxQuoteV4.wellFormed ⟨0, 0⟩ = false :=
  TdxQuoteV4.wellFormed_empty

/-! ## Axioms -/

#print axioms segStatement_digest
#print axioms segQuote_bindsStatement
#print axioms segQuote_bindsCompose
#print axioms segQuote_digest
#print axioms segQuote_rejectsAlteredDigest
#print axioms segQuote_rejectsAlteredCompose
#print axioms segQuoteTruncated_rejected
#print axioms segQuoteTruncated_bindsNoStatement

end SparkInterval.Tests.PhalaTdxSegEvidence
