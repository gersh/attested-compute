        { a := 0xa535b36c, b := 0x83e3afdf, c := 0xfc69a78e, d := 0x2cf6fd23, e := 0x69ab464d, f := 0xf77f7d34, g := 0xd4213315, h := 0xeb00e178 } =
      { a := 0x3433a017, b := 0x73672eed, c := 0x777ab925, d := 0x9d6ccce4, e := 0xdacd5ffd, f := 0xece947a2, g := 0xa2c6be73, h := 0x698072ef } := by
