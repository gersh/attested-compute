import SparkInterval.Certificate.SHA256Vectors
import SparkInterval.Execution.TdxQuoteV4

/-!
# The statement-to-quote chain, closed in the Lean kernel

This module takes the retained evidence of one real Intel TDX run and closes,
by kernel reduction alone, the link that used to be an assertion:

```text
statement.json bytes
  --[SHA-256, computed here]-->  53e58440...c7233f5d
  --[= report_data[0:32] parsed out of tdx-quote.bin]-->  the quote
  --[mr_config_id = 01 || compose_hash]-->  the measured app-compose document
```

The run is the leancompcert Platt stronger-range campaign on Phala Cloud,
`2026-07-30T20:48:50Z`, dstack app `cd97d16fdc4dc1dd8fc9d5f71acb21f46bcb1b6c`.
Its evidence is committed at `tests/data/phala_tdx_seg/`:
`statement.json` (1080 bytes) and `tdx-quote.bin` (5010 bytes).

## What is proved, and by what

Every theorem below is closed by `rfl` or by composing `rfl` chunks.  There is
no `native_decide`, no `decide +kernel`, and no axiom beyond the base trio.
The digests are produced by reducing this repository's own SHA-256
implementation -- the same one FIPS 180-4 vectors are checked against in
`Certificate/SHA256Vectors.lean` -- inside the kernel.

Reaching 1111 bytes and 5010 bytes at all requires
`Certificate/SHA256Chunked.lean`'s splitting law and
`Certificate/SHA256Packed.lean`'s packed representation.  A single unsplit
reduction of either message exceeds the build's `-M8192` cap; so does a
byte-array-backed source at any chunk size, because its byte reads are linear
in the index.

## What is *not* proved

That Intel signed the quote.  The ECDSA signature, the PCK certificate chain,
the TCB level, and the QE identity are not parsed and not verified here;
`dcap-qvl` appraises them outside Lean, and its output is retained beside the
quote at `tests/data/phala_tdx_seg/dcap-qvl-verify.stdout`.  That file's
`mr_config_id` and `report_data` agree with what Lean parses below, which is a
useful cross-check and not a proof.
-/

set_option autoImplicit false
set_option maxRecDepth 400000
set_option maxHeartbeats 4000000
set_option exponentiation.threshold 20000

namespace SparkInterval.Tests.PhalaTdxSegEvidence

open SparkInterval.Certificate
open SparkInterval.Certificate.SHA256
open SparkInterval.Execution

/-! ## The evidence, as literals

Both literals are emitted from the committed files by
`tools/tg_phala_tdx_lean_evidence.py packed`, and
`tests/test_phala_tdx_seg_evidence.py` fails if either drifts from the file it
claims to be. -/

/-- `b"phala-tdx-bound-computation.v1\x00"`: the domain separator the payload
prepends before hashing the statement. -/
def segDomainPrefix : ByteSource :=
  packedByteSource 0x7068616c612d7464782d626f756e642d636f6d7075746174696f6e2e763100 31

/-- The exact bytes of `tests/data/phala_tdx_seg/statement.json`. -/
def segStatementBytes : ByteSource :=
  packedByteSource  1080

/-- The preimage the enclave hashed into the quote's report data. -/
def segStatementPreimage : ByteSource :=
  ByteSource.append segDomainPrefix segStatementBytes

/-- The exact bytes of `tests/data/phala_tdx_seg/tdx-quote.bin`. -/
def segQuote : PackedBytes :=
  ⟨, 5010⟩

/-- The reviewed app-compose hash of the deployment, as it appears in
`statement.json`. -/
def segComposeHash : String :=
  "37cee7b985b13b3f88585eec9a6b9e9b01e34729d4c93ce75f79fa4354bff2b8"

/-! ## The statement digest, chunked

18 padded blocks, in chunks of six.  The intermediate states come from
`tools/tg_sha256_chunk_witnesses.py`. -/

theorem segStatement_blocks :
    segStatementPreimage.paddedSize / 64 = 6 + (6 + (6)) :=
  rfl

/-- Chunk 0: blocks 0 to 6. -/
private theorem segStatement_chunk0 :
    foldSourceBlocks (sourceBlockStep segStatementPreimage) 6 0
        { a := 0x6a09e667, b := 0xbb67ae85, c := 0x3c6ef372, d := 0xa54ff53a, e := 0x510e527f, f := 0x9b05688c, g := 0x1f83d9ab, h := 0x5be0cd19 } =
      { a := 0xb5fcd605, b := 0x9b9bbec9, c := 0xbb7bad27, d := 0xba64987c, e := 0xc02c5b3e, f := 0xa9ff8a73, g := 0xb6db037a, h := 0xc4e86154 } := by
  rfl

/-- Chunk 1: blocks 6 to 12. -/
private theorem segStatement_chunk1 :
    foldSourceBlocks (sourceBlockStep segStatementPreimage) 6 384
        { a := 0xb5fcd605, b := 0x9b9bbec9, c := 0xbb7bad27, d := 0xba64987c, e := 0xc02c5b3e, f := 0xa9ff8a73, g := 0xb6db037a, h := 0xc4e86154 } =
      { a := 0x98196386, b := 0x693a38ac, c := 0xf3b2ac2e, d := 0x91cf454d, e := 0x8e7fa8be, f := 0x80469d1f, g := 0x3f46c89b, h := 0x2df1cbd6 } := by
  rfl

/-- Chunk 2: blocks 12 to 18. -/
private theorem segStatement_chunk2 :
    foldSourceBlocks (sourceBlockStep segStatementPreimage) 6 768
        { a := 0x98196386, b := 0x693a38ac, c := 0xf3b2ac2e, d := 0x91cf454d, e := 0x8e7fa8be, f := 0x80469d1f, g := 0x3f46c89b, h := 0x2df1cbd6 } =
      { a := 0x53e58440, b := 0x9d7572f8, c := 0x7f1e00cd, d := 0x8441a357, e := 0x74d697af, f := 0x216021be, g := 0x2cdf8f9f, h := 0xc7233f5d } := by
  rfl

/-- **The computed statement digest.**  SHA-256 of the domain separator
followed by the 1080 bytes of `statement.json`, reduced in the kernel. -/
theorem segStatement_digest :
    digestSource segStatementPreimage =
      "53e584409d7572f87f1e00cd8441a35774d697af216021be2cdf8f9fc7233f5d" := by
  rw [digestSource_eq_of_chunks segStatement_blocks
    (foldSourceBlocks_of_split _ segStatement_chunk0 (foldSourceBlocks_of_split _ segStatement_chunk1 (segStatement_chunk2)))]
  rfl

/-! ## The quote, parsed -/

theorem segQuote_wellFormed : TdxQuoteV4.wellFormed segQuote = true := rfl

theorem segQuote_version : TdxQuoteV4.version segQuote = 4 := rfl

theorem segQuote_teeType : TdxQuoteV4.teeType segQuote = 0x81 := rfl

/-- **The measured configuration is the pinned compose document.**
`mr_config_id` is `01` followed by the app-compose SHA-256 and fifteen zero
bytes, exactly as dstack writes it. -/
theorem segQuote_mrConfigId :
    TdxQuoteV4.mrConfigIdHex segQuote =
      "0137cee7b985b13b3f88585eec9a6b9e9b01e34729d4c93ce75f79fa4354bff2b8000000000000000000000000000000" :=
  rfl

theorem segQuote_bindsCompose :
    TdxQuoteV4.quoteBindsCompose segQuote segComposeHash = true := rfl

/-- **The link that used to be an assertion.**  The quote's own report data is
the digest computed above, and its upper half is zero. -/
theorem segQuote_bindsStatement :
    TdxQuoteV4.quoteBindsStatement segQuote
      (digestSource segStatementPreimage) = true := by
  rw [segStatement_digest]
  rfl

/-! ## The quote's own digest, chunked

79 padded blocks, in chunks of eight.  This is what a receipt's signed
`tdx_quote_sha256` has to equal for `phalaTdxQuoteCheck` to accept, so it is
what stops a genuine receipt being paired with an unrelated genuine quote. -/

theorem segQuote_digestBlocks :
    segQuote.source.paddedSize / 64 = 8 + (8 + (8 + (8 + (8 + (8 + (8 + (8 + (8 + (7))))))))) :=
  rfl

/-- Chunk 0: blocks 0 to 8. -/
private theorem segQuote_chunk0 :
    foldSourceBlocks (sourceBlockStep segQuote.source) 8 0
        { a := 0x6a09e667, b := 0xbb67ae85, c := 0x3c6ef372, d := 0xa54ff53a, e := 0x510e527f, f := 0x9b05688c, g := 0x1f83d9ab, h := 0x5be0cd19 } =
      { a := 0xa535b36c, b := 0x83e3afdf, c := 0xfc69a78e, d := 0x2cf6fd23, e := 0x69ab464d, f := 0xf77f7d34, g := 0xd4213315, h := 0xeb00e178 } := by
  rfl

/-- Chunk 1: blocks 8 to 16. -/
private theorem segQuote_chunk1 :
